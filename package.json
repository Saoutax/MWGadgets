{
    "name": "mwgadgets",
    "description": "MediaWiki Gadgets",
    "keywords": [
        "mediawiki"
    ],
    "bugs": {
        "url": "https://github.com/Saoutax/MWGadgets/issues"
    },
    "license": "MIT",
    "author": "Saoutax",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Saoutax/MWGadgets.git"
    },
    "type": "module",
    "scripts": {
        "build": "tsx ./scripts/build.ts",
        "fmt": "oxfmt",
        "lint": "pnpm run lint:js && pnpm run lint:css",
        "lint:css": "stylelint src/**/*.css src/**/*.scss",
        "lint:css:fix": "stylelint src/**/*.css src/**/*.scss --fix",
        "lint:fix": "pnpm run lint:js:fix && pnpm run lint:css:fix",
        "lint:js": "eslint src/",
        "lint:js:fix": "eslint src/ --fix",
        "prepare": "husky"
    },
    "dependencies": {
        "buffer": "^6.0.3",
        "octokit": "^5.0.5",
        "preact": "^10.29.2",
        "sass-embedded": "^1.100.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-lib-inject-css": "^2.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@stylistic/stylelint-plugin": "^5.2.0",
        "@types/jquery": "^4.0.0",
        "@types/node": "^25.9.1",
        "eslint": "^10.4.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "oxfmt": "^0.51.0",
        "stylelint": "^17.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-scss": "^7.0.0",
        "types-mediawiki": "^2.0.0",
        "typescript-eslint": "^8.59.4"
    },
    "packageManager": "pnpm@11.2.2"
}
