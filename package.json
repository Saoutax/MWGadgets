{
    "name": "mwgadgets",
    "description": "MediaWiki Gadgets",
    "scripts": {
        "build": "npx tsx ./scripts/build.ts",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx && stylelint src/**/*.css src/**/*.scss",
        "lint:js": "eslint . --ext .ts,.tsx,.js,.jsx",
        "lint:css": "stylelint src/**/*.css src/**/*.scss",
        "lint:fix": "eslint --fix 'src/**/*.{ts,tsx,js,jsx}' && stylelint --fix 'src/**/*.{css,scss}'",
        "lint:fix:js": "eslint --fix 'src/**/*.{ts,tsx,js,jsx}'",
        "lint:fix:css": "stylelint --fix 'src/**/*.{css,scss}'",
        "prettier": "prettier --check .",
        "prettier:fix": "prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Saoutax/MWGadgets.git"
    },
    "keywords": [
        "mediawiki"
    ],
    "author": "Saoutax",
    "license": "MIT",
    "type": "module",
    "bugs": {
        "url": "https://github.com/Saoutax/MWGadgets/issues"
    },
    "packageManager": "pnpm@10.28.1",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@eslint/markdown": "^7.5.1",
        "@stylistic/stylelint-plugin": "^5.0.1",
        "@types/jquery": "^3.5.33",
        "@types/node": "^25.2.2",
        "eslint": "^9.39.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^17.3.0",
        "less": "^4.5.1",
        "preact": "^10.28.3",
        "prettier": "^3.8.1",
        "sass": "^1.97.3",
        "sass-embedded": "^1.97.3",
        "stylelint": "^16.26.1",
        "stylelint-config-standard-scss": "^16.0.0",
        "stylelint-scss": "^7.0.0",
        "terser": "^5.46.0",
        "tsconfig-paths": "^4.2.0",
        "types-mediawiki": "^2.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.55.0",
        "vite": "^7.3.1",
        "vite-plugin-lib-inject-css": "^2.2.2",
        "vue": "^3.5.27"
    },
    "dependencies": {
        "buffer": "^6.0.3",
        "octokit": "^5.0.5",
        "tsx": "^4.21.0"
    }
}
