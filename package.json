{
    "name": "mwgadgets",
    "description": "MediaWiki Gadgets",
    "keywords": [
        "mediawiki"
    ],
    "bugs": {
        "url": "https://github.com/Saoutax/MWGadgets/issues"
    },
    "license": "MIT",
    "author": "Saoutax",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Saoutax/MWGadgets.git"
    },
    "type": "module",
    "scripts": {
        "build": "tsx ./scripts/build.ts",
        "fmt": "oxfmt",
        "lint": "pnpm run lint:js && pnpm run lint:css",
        "lint:css": "stylelint src/**/*.css src/**/*.scss",
        "lint:css:fix": "stylelint src/**/*.css src/**/*.scss --fix",
        "lint:fix": "pnpm run lint:js:fix && pnpm run lint:css:fix",
        "lint:js": "oxlint src/",
        "lint:js:fix": "oxlint src/ --fix"
    },
    "dependencies": {
        "buffer": "^6.0.3",
        "octokit": "^5.0.5",
        "preact": "^10.29.2",
        "sass-embedded": "^1.100.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-lib-inject-css": "^2.2.2"
    },
    "devDependencies": {
        "@stylistic/stylelint-plugin": "^5.2.0",
        "@types/jquery": "^4.0.1",
        "@types/node": "^25.9.3",
        "@types/oojs": "^7.0.7",
        "@types/oojs-ui": "^0.50.0",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "stylelint": "^17.13.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-scss": "^7.2.0",
        "types-mediawiki": "^2.0.0"
    },
    "packageManager": "pnpm@11.8.0"
}
